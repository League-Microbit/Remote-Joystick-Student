Two stretches, in order:
1. subtract the measured centre, then scale each half of the *raw*
travel to full scale independently — the centre is rarely at 512,
so the two halves have different spans and need different gains.
2. blank the +/- DEAD_ZONE band around zero, then stretch each
remaining tail back out so it still reaches full scale.</comment><data>2</data><value name="esyl1vos2n7862e8e1ui"><block type="argument_reporter_number" id="PU`]LvhCG/I(o77yxZbc" deletable="false"><field name="VALUE">raw</field></block></value><value name="10kw9b4sebywwjy7020y"><block type="argument_reporter_number" id="^y37PyneY:fT]#(Fe0p7" deletable="false"><field name="VALUE">centre</field></block></value><statement name="STACK"><block type="variables_set" id=";_m~QvM/A5wz+MfqjN6g"><field name="VAR" id="O(o1uCs{,iTVh/A~f^`6">d</field><value name="VALUE"><shadow type="math_number" id="1#o){rOg1Odub#6_J8=p"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="JQM2BIQCL]0c*_GRG~C!"><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="1F]MY:[kTIdZh{G{@jak"><field name="NUM">0</field></shadow><block type="argument_reporter_number" id="yJA[=0~$aRP]m?@.usm("><field name="VALUE">raw</field></block></value><value name="B"><shadow type="math_number" id="R;T30Bwt}-G83(`c*vL$"><field name="NUM">0</field></shadow><block type="argument_reporter_number" id="ML4jW$WzcnWM4BH+v!u{"><field name="VALUE">centre</field></block></value></block></value><next><block type="controls_if" id="rs+PU7keEHOfqSgWJOAa"><mutation else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id=".s=6+)-hIW4ECQHZp?dn"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="-{tLCyT?7Yil2b}=i`Pw"><field name="OP">GTE</field><value name="A"><shadow type="math_number" id="%G?lW-RYM}}9S:,oT5(g"><field name="NUM">0</field></shadow><block type="variables_get" id="~0x)~I*YZYV_{`pfsF3W"><field name="VAR" id="O(o1uCs{,iTVh/A~f^`6">d</field></block></value><value name="B"><shadow type="math_number" id="-~vd5dlFI=y,Hs/[WWru"><field name="NUM">0</field></shadow></value></block></value><statement name="DO0"><block type="variables_set" id="d05t3=21u6$OKUm0`?%y"><field name="VAR" id="~yn#4}N@[XwA1FrK{(~o">span</field><value name="VALUE"><shadow type="mat